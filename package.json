{
  "name": "albumdrop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check": "npm run format:check && npm run lint && npm test && npm run build",
    "test:large": "LARGE_ZIP_TEST=1 node --test test/download.test.js",
    "cloudflare:dev": "wrangler pages dev dist",
    "cloudflare:deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.24.0",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "vite": "^6.4.1",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=24"
  }
}
